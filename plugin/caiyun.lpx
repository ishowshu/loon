#!name = 彩云天气Pro
#!desc = 简单屏蔽一些广告
#!author = 树先生
#!icon = https://github.com/ishowshu/loon/raw/refs/heads/main/icon/colorful_cloud_pro.png

[Rule]
DOMAIN,abyss.cyapi.cn,REJECT
DOMAIN,ad.cyapi.cn,REJECT

[Rewrite]
^https:\/\/starplucker\.cyapi\.cn\/v3\/(config\/cypage\/\w+\/conditions|notification\/message_center|operation\/homefeatures) reject_dict

[Script]
http-response ^https:\/\/api\.caiyunapp\.com\/v1\/activity\? script-path = https://github.com/ishowshu/qx/raw/refs/heads/main/script/caiyun.js, requires-body = true, tag = 移除彩云广告
http-response ^https:\/\/wrapper\.cyapi\.cn\/v1\/activity\? script-path = https://github.com/ishowshu/qx/raw/refs/heads/main/script/caiyun.js, requires-body = true, tag = 移除彩云广告
http-response ^https:\/\/wrapper\.cyapi\.cn\/v1\/(nafp\/origin_images|satellite)\? script-path = https://github.com/ishowshu/qx/raw/refs/heads/main/script/caiyun.js, requires-body = true, tag = 移除彩云广告

[MitM]
hostname = wrapper.cyapi.cn,api.caiyunapp.com,starplucker.cyapi.cn
