[Rewrite]
request if ${url} ~= /^https:\/\/starplucker\.cyapi\.cn\/v3\/(config\/cypage\/\w+\/conditions|notification\/message_center|operation\/homefeatures)/ then reject_dict(200)

[MitM]
hostname = wrapper.cyapi.cn,api.caiyunapp.com,starplucker.cyapi.cn